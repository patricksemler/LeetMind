{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "MOCK_PORT=8085",
        "VITE_API_BASE=http://localhost:8085",
        "pnpm",
        "--filter",
        "@leetmind/web",
        "dev:mock"
      ],
      "port": 5173
    },
    {
      "_comment": "Second mock stack on its own ports, so a second session can run one while 'web' is already up on 5173/8085.",
      "name": "web-mock-alt",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "MOCK_PORT=8087",
        "WEB_PORT=5175",
        "VITE_API_BASE=http://localhost:8087",
        "pnpm",
        "--filter",
        "@leetmind/web",
        "dev:mock"
      ],
      "port": 5175
    },
    {
      "_comment": "Third mock stack, same idea as web-mock-alt — 5173/5175 are both taken often enough that a third session needs its own pair.",
