{
  "id": null,
  "uid": "algolift-m5",
  "title": "AlgoLift — Ops & Evidence (M5)",
  "description": "Queue depth/wait, judge throughput, verdict mix, generation funnel, worker liveness, buffer depth — all from GET /metrics (apps/api/src/routes/metrics.ts), the same SQL that backs /api/system/stats.",
  "tags": ["algolift", "m5"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Queue",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Queue depth by kind + status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "algolift-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "algolift-prometheus" },
          "expr": "algolift_queue_depth",
          "legendFormat": "{{kind}} / {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Queue wait time (enqueue -> claim), p50 / p95",
      "description": "Queue.stats() approximation over the trailing hour — see packages/queue/src/queue.ts doc comment.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "algolift-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "algolift-prometheus" },
          "expr": "algolift_queue_wait_ms",
          "legendFormat": "p{{quantile}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Oldest queued job age",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "algolift-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "algolift-prometheus" },
          "expr": "max(algolift_queue_oldest_queued_age_ms)",
          "legendFormat": "oldest queued",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Dead jobs",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "algolift-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "algolift-prometheus" },
          "expr": "algolift_queue_dead_jobs",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Lease recovery outcomes",
      "description": "Jobs ever tagged lease-expired, bucketed by outcome. See LeaseRecoveryStats doc comment for precision caveats.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "algolift-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "algolift-prometheus" },
          "expr": "algolift_queue_lease_recovery",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Judge",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Judge throughput (submissions/min)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "algolift-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "algolift-prometheus" },
          "expr": "sum(rate(algolift_submissions_verdict_total[5m])) * 60",
          "legendFormat": "submissions / min",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Verdict mix (all-time counts)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "algolift-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "algolift-prometheus" },
          "expr": "algolift_submissions_verdict_total",
          "legendFormat": "{{verdict}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Submission latency (p50 / p95 / p99, created -> completed)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "algolift-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "algolift-prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(algolift_submission_latency_ms_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "algolift-prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(algolift_submission_latency_ms_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "algolift-prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(algolift_submission_latency_ms_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Worker liveness",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "algolift-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "algolift-prometheus" },
          "expr": "algolift_worker_up",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 30,
      "type": "row",
      "title": "Content plane",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Generation funnel — pass/fail by verification stage",
      "description": "docs/CONTRACTS.md §10: schema -> compile -> differential -> boundary -> examples -> mutation, first failure short-circuits the rest.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "datasource": { "type": "prometheus", "uid": "algolift-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "algolift-prometheus" },
          "expr": "algolift_generation_stage_total",
          "legendFormat": "{{stage}} / {{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Buffer depth per concept x rating band",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "datasource": { "type": "prometheus", "uid": "algolift-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "algolift-prometheus" },
          "expr": "algolift_buffer_depth",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    }
  ]
}
