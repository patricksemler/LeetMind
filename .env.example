# apps/web. Copy to `.env` (gitignored) and adjust. Loaded by Vite (vite.config.ts points envDir
# at this directory). Only `VITE_`-prefixed variables reach browser code, and every one of them is
# baked into the built bundle — never put a secret here.

# Port for `pnpm dev` and `pnpm preview`.
WEB_PORT=5173

# Where the API lives. The dev server proxies /api and /health there, so the browser sees a
# same-origin app.
VITE_API_BASE=http://localhost:8080

# Supabase Auth, spoken directly from the browser — the API only ever sees a verified token.
# Required: without these, every route past /login redirects back to it. Below is the local
# `supabase start` stack (`supabase status -o env` prints its anon key); swap in a hosted project
# to deploy. The anon key is publishable by design.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Playwright (`pnpm e2e`) only, and read from the process environment rather than this file —
# export them, or prefix the command. E2E_BASE_URL points at an already-running web server; the
# spec skips itself unless the credentials name a real Supabase user.
E2E_BASE_URL=http://localhost:5173
E2E_EMAIL=
E2E_PASSWORD=
