# Copy to `.env` (gitignored) and adjust. Vite reads this file at startup; only `VITE_`-prefixed
# variables are exposed to browser code, and every one of them ends up in the built bundle — never
# put a secret here.

# Port the dev server and `vite preview` listen on.
WEB_PORT=5173

# Where the API lives. This repo is the frontend alone, so something must be serving the API at
# this address: the dev server proxies `/api` and `/health` there, and the app has no other source
# of problems, submissions, or hints.
VITE_API_BASE=http://localhost:8080

# The browser talks to Supabase Auth directly; the API never sees a credential. Leave both unset to
# build a single-user app with no sign-in — the backend must agree, and is single-user whenever
# SUPABASE_URL is absent from ITS environment.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Consumed by the Playwright e2e smoke (`pnpm e2e`), not by the app. E2E_BASE_URL points at an
# already-running web server; the credentials are only needed when that stack has auth enabled.
E2E_BASE_URL=http://localhost:5173
E2E_EMAIL=
E2E_PASSWORD=
