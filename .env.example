# LeetMind environment variables.
# See docs/CONTRACTS.md §2 for the authoritative table. Copy to .env and adjust as needed.
# Config is parsed once at startup with zod (TS) / pydantic-settings (Python); missing required
# vars fail loudly at boot.

# ---------------------------------------------------------------------------
# Core / shared by all services
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://leetmind:leetmind@localhost:5432/leetmind
PGPOOL_MAX=10
LOG_LEVEL=info
NODE_ENV=development
SINGLE_USER_ID=00000000000000000000000001

# ---------------------------------------------------------------------------
# Tests (docs/CONTRACTS.md §13 — MANDATORY test database isolation)
# ---------------------------------------------------------------------------
# Tests never read DATABASE_URL (it defaults to the development database, and LeetMind is a tool
# used daily — a test suite that truncated it would destroy real practice history). They read
# TEST_DATABASE_URL instead. It MUST point at a database whose name ends in "_test" (or is
# exactly "test"); a guard (`assertTestDatabase` in @leetmind/db, `assert_test_database` in
# content/leetmind_content/db.py) checks this before any destructive fixture runs and fails the
# whole test run loudly if it doesn't hold. Uncomment/adjust to override the default below.
# TEST_DATABASE_URL=postgres://leetmind:leetmind@localhost:5432/leetmind_test

# ---------------------------------------------------------------------------
# api (apps/api)
# ---------------------------------------------------------------------------
API_PORT=8080
API_HOST=0.0.0.0

# --- accounts (Supabase Auth) ----------------------------------------------
# Presence of SUPABASE_URL is what turns authentication on outside production; in production it is
# mandatory and the API refuses to boot without it rather than serving one shared anonymous
# account. `supabase status -o env` prints these for a local stack.
SUPABASE_URL=
# Symmetric HS256 secret. Leave UNSET for any project that signs with asymmetric keys (current
# hosted projects, and local `supabase start`) — those are verified against the project's published
# JWKS. Which path a token takes is decided by the token's own header, so a project mid-rotation
# works either way.
SUPABASE_JWT_SECRET=
# Explicit override of the rule above. Set to `false` to run a single-user local stack that pins
# every request to SINGLE_USER_ID (the pre-accounts behaviour).
AUTH_REQUIRED=
# Opt-in: the one email address allowed to adopt the pre-accounts SINGLE_USER_ID practice history.
# The first account signing in with exactly this address takes ownership of that row. Unset means
# nobody ever claims it.
LEGACY_CLAIM_EMAIL=

# ---------------------------------------------------------------------------
# web (apps/web)
# ---------------------------------------------------------------------------
WEB_PORT=5173
VITE_API_BASE=http://localhost:8080
# The browser talks to Supabase Auth directly; the API never sees a credential. Leave both unset
# to build a single-user web app with no sign-in (matches AUTH_REQUIRED=false).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# judge (apps/judge)
# ---------------------------------------------------------------------------
# default: `${hostname}-${pid}` computed at process start when unset
JUDGE_WORKER_ID=
JUDGE_CONCURRENCY=2

# ---------------------------------------------------------------------------
# queue (@leetmind/queue, used by judge/content)
# ---------------------------------------------------------------------------
QUEUE_LEASE_SECONDS=30
QUEUE_HEARTBEAT_MS=10000
QUEUE_REAPER_INTERVAL_MS=5000
QUEUE_POLL_INTERVAL_MS=500

# ---------------------------------------------------------------------------
# sandbox (@leetmind/sandbox, used by judge/content)
# ---------------------------------------------------------------------------
SANDBOX_PYTHON_IMAGE=leetmind/runner-python:1
SANDBOX_CPP_IMAGE=leetmind/runner-cpp:1
SANDBOX_MEMORY_MB=256
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=64
SANDBOX_WALL_TIMEOUT_MS=10000
SANDBOX_OUTPUT_LIMIT_BYTES=65536
SANDBOX_WORK_DIR=/tmp/leetmind-sandbox
DOCKER_BIN=docker
# Dev/QA only — never set in production or CI. A real judge run finishes in ~150-300ms, too fast
# to ever observe the UI's pending/running intermediate states. Set to e.g. 4000 to hold every
# sandbox run open that much longer before returning, so those states become watchable.
LEETMIND_SANDBOX_ARTIFICIAL_DELAY_MS=

# ---------------------------------------------------------------------------
# content (Python content plane)
# ---------------------------------------------------------------------------
# default: `${hostname}-${pid}` computed at process start when unset
CONTENT_WORKER_ID=
GENERATOR_INVOKER=claude
CLAUDE_BIN=claude
# default: unset, i.e. no --model flag at all (whatever `claude -p` defaults to). Set explicitly
# so generation quality/cost are attributable to a deliberate, recorded model choice.
GENERATOR_MODEL=
GENERATOR_TIMEOUT_MS=600000
GENERATOR_MAX_SCHEMA_RETRIES=2
BUFFER_LOW_WATERMARK=3
REPLENISH_INTERVAL_MS=60000
VERIFY_DIFFERENTIAL_CASES=200
