# AlgoLift environment variables.
# See docs/CONTRACTS.md §2 for the authoritative table. Copy to .env and adjust as needed.
# Config is parsed once at startup with zod (TS) / pydantic-settings (Python); missing required
# vars fail loudly at boot.

# ---------------------------------------------------------------------------
# Core / shared by all services
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://algolift:algolift@localhost:5432/algolift
PGPOOL_MAX=10
LOG_LEVEL=info
NODE_ENV=development
SINGLE_USER_ID=00000000000000000000000001

# ---------------------------------------------------------------------------
# Tests (docs/CONTRACTS.md §13 — MANDATORY test database isolation)
# ---------------------------------------------------------------------------
# Tests never read DATABASE_URL (it defaults to the development database, and AlgoLift is a tool
# used daily — a test suite that truncated it would destroy real practice history). They read
# TEST_DATABASE_URL instead. It MUST point at a database whose name ends in "_test" (or is
# exactly "test"); a guard (`assertTestDatabase` in @algolift/db, `assert_test_database` in
# content/algolift_content/db.py) checks this before any destructive fixture runs and fails the
# whole test run loudly if it doesn't hold. Uncomment/adjust to override the default below.
# TEST_DATABASE_URL=postgres://algolift:algolift@localhost:5432/algolift_test

# ---------------------------------------------------------------------------
# api (apps/api)
# ---------------------------------------------------------------------------
API_PORT=8080
API_HOST=0.0.0.0

# ---------------------------------------------------------------------------
# web (apps/web)
# ---------------------------------------------------------------------------
WEB_PORT=5173
VITE_API_BASE=http://localhost:8080

# ---------------------------------------------------------------------------
# judge (apps/judge)
# ---------------------------------------------------------------------------
# default: `${hostname}-${pid}` computed at process start when unset
JUDGE_WORKER_ID=
JUDGE_CONCURRENCY=2

# ---------------------------------------------------------------------------
# queue (@algolift/queue, used by judge/content)
# ---------------------------------------------------------------------------
QUEUE_LEASE_SECONDS=30
QUEUE_HEARTBEAT_MS=10000
QUEUE_REAPER_INTERVAL_MS=5000
QUEUE_POLL_INTERVAL_MS=500

# ---------------------------------------------------------------------------
# sandbox (@algolift/sandbox, used by judge/content)
# ---------------------------------------------------------------------------
SANDBOX_PYTHON_IMAGE=algolift/runner-python:1
SANDBOX_CPP_IMAGE=algolift/runner-cpp:1
SANDBOX_MEMORY_MB=256
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=64
SANDBOX_WALL_TIMEOUT_MS=10000
SANDBOX_OUTPUT_LIMIT_BYTES=65536
SANDBOX_WORK_DIR=/tmp/algolift-sandbox
DOCKER_BIN=docker

# ---------------------------------------------------------------------------
# content (Python content plane)
# ---------------------------------------------------------------------------
# default: `${hostname}-${pid}` computed at process start when unset
CONTENT_WORKER_ID=
GENERATOR_INVOKER=claude
CLAUDE_BIN=claude
# default: unset, i.e. no --model flag at all (whatever `claude -p` defaults to). Set explicitly
# so generation quality/cost are attributable to a deliberate, recorded model choice.
GENERATOR_MODEL=
GENERATOR_TIMEOUT_MS=600000
GENERATOR_MAX_SCHEMA_RETRIES=2
BUFFER_LOW_WATERMARK=3
REPLENISH_INTERVAL_MS=60000
VERIFY_DIFFERENTIAL_CASES=200
