{
  "name": "@leetmind/judge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "rejudge": "tsx src/rejudge.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "build": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "pg": "^8.13.0",
    "@leetmind/shared": "workspace:*",
    "@leetmind/db": "workspace:*",
    "@leetmind/queue": "workspace:*",
    "@leetmind/sandbox": "workspace:*",
    "@leetmind/learner": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "tsx": "^4.0.0",
    "vitest": "^3.0.0"
  }
}
