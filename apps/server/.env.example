# Copy to `.env` (gitignored) and adjust. Parsed once at startup by config.py, anchored to this
# directory regardless of CWD. Every setting has a default in config.py, so anything left unset
# here falls back silently — this file only overrides. The one you must set is SUPABASE_URL:
# auth is mandatory (PLAN_BACKEND.md §9) and without it every authed route 401s.

DATABASE_URL=postgres://leetmind:leetmind@localhost:5432/leetmind
LOG_LEVEL=info

# Tests never read DATABASE_URL — they read TEST_DATABASE_URL, which must point at a database
# whose name is "test" or ends in "_test" (enforced by assert_test_database in db.py before any
# destructive fixture runs).
TEST_DATABASE_URL=postgres://leetmind:leetmind@localhost:5432/leetmind_test

# --- accounts (Supabase Auth) ------------------------------------------------
# Required: auth is mandatory (PLAN_BACKEND.md §9). The auth dependency verifies asymmetric
# (RS256/ES256) tokens via this project's published JWKS at /auth/v1/.well-known/jwks.json.
# http://127.0.0.1:54321 is the local `supabase start` stack; swap in a hosted project's URL to
# deploy. `supabase status -o env` prints the local values.
SUPABASE_URL=http://127.0.0.1:54321
# Symmetric HS256 secret. Leave unset for any project that signs with asymmetric keys (current
# hosted projects, and local `supabase start`) — those verify against SUPABASE_URL's JWKS instead.
SUPABASE_JWT_SECRET=

# --- web (apps/web) -----------------------------------------------------------
# Origin allowed by CORS. Must match the frontend's dev/build origin exactly.
WEB_ORIGIN=http://localhost:5173

HOST=0.0.0.0
PORT=8080

# --- generation pipeline (PLAN_BACKEND.md §7) ---------------------------------
# LLM_CLI selects the subprocess adapter: "claude" (claude -p, default) or "codex" (codex exec).
# The CLI must already be logged in on this machine — no API keys live here (decision 12).
# "fixture" skips the CLI entirely and returns the same canned "sum a list" problem the pytest
# suite uses (leetmind.fixtures) — no subprocess, no login needed. For a live server with nothing
# real to call: the Playwright e2e smoke (§12: "stubbed LLM via fixture mode flag").
LLM_CLI=claude
# Override the executable name/path; defaults to LLM_CLI.
LLM_BIN=
LLM_MODEL=claude-sonnet-5
# Whitespace-split extra flags appended to every call — e.g. the CLI's own tool-disable flags
# (amendment 37). Kept here, not hardcoded, so flags can change without a deploy.
LLM_ARGS=
LLM_TIMEOUT_S=600
# Amendment 40: an optional genuine sandbox boundary (its own container) for hosted deployments.
# Off by default — local-first (decision 19).
LLM_CONTAINER=false
LLM_CONTAINER_IMAGE=leetmind-llm-cli

# Set to false to disable the generation worker task (e.g. a read-only replica process).
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_S=2
WORKER_HEARTBEAT_INTERVAL_S=60
WORKER_LEASE_STALE_S=300
