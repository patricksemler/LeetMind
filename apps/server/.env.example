# apps/server. Copy to `.env` (gitignored) and adjust. Parsed once at startup by config.py,
# anchored to this directory regardless of CWD. Every setting has a default there, so anything
# left unset here falls back silently — this file only overrides. Commented lines show the
# default.

DATABASE_URL=postgres://leetmind:leetmind@localhost:5432/leetmind
LOG_LEVEL=info

# pytest reads this from the process environment, not from this file (config.py parses .env into
# Settings, never into os.environ) — so `export TEST_DATABASE_URL=...` or the suite skips. The
# database name must be "test" or end in "_test"; assert_test_database in db.py enforces that
# before any destructive fixture runs, so a test run can't truncate DATABASE_URL's database.
TEST_DATABASE_URL=postgres://leetmind:leetmind@localhost:5432/leetmind_test

# --- accounts (Supabase Auth) -------------------------------------------------
# Required — without it every authed route 401s. Tokens are verified asymmetrically (RS256/ES256)
# against this project's published JWKS at /auth/v1/.well-known/jwks.json. Below is the local
# `supabase start` stack; swap in a hosted project's URL to deploy.
SUPABASE_URL=http://127.0.0.1:54321
# Symmetric HS256 secret, for a legacy project that still signs that way. Leave unset for anything
# signing asymmetrically — current hosted projects and local `supabase start` both do.
SUPABASE_JWT_SECRET=

# --- http ---------------------------------------------------------------------
# Origin allowed by CORS. Must match the frontend's dev/build origin exactly.
WEB_ORIGIN=http://localhost:5173
HOST=0.0.0.0
PORT=8080

# --- generation ---------------------------------------------------------------
# The subprocess adapter: "claude" (claude -p), "codex" (codex exec), or "fixture". The CLI must
# already be logged in on this machine — no API keys live here. "fixture" skips the subprocess
# entirely and returns the canned problem the pytest suite uses (leetmind.fixtures), which is what
# the Playwright smoke and `docker compose up` run against.
LLM_CLI=claude
LLM_MODEL=claude-sonnet-5
# LLM_BIN=                       # executable name/path override; defaults to LLM_CLI
# LLM_ARGS=                      # whitespace-split extra flags appended to every call
# LLM_TIMEOUT_S=600
# Run the CLI in its own container, mounting nothing beyond the temp/auth dirs — a real boundary
# for hosted deployments, where a cwd plus a read-only mount still doesn't stop absolute-path
# reads. Off by default; local-first.
# LLM_CONTAINER=false
# LLM_CONTAINER_IMAGE=leetmind-llm-cli

# --- generation worker --------------------------------------------------------
# WORKER_ENABLED=true            # false disables the background job task in this process
# WORKER_POLL_INTERVAL_S=2
# WORKER_HEARTBEAT_INTERVAL_S=60
# WORKER_LEASE_STALE_S=300       # a lease idle this long is reclaimable by another worker

# --- judge --------------------------------------------------------------------
# JUDGE_IMAGE=leetmind-judge     # must exist on the host daemon: docker compose build judge
# JUDGE_CONCURRENCY=4            # simultaneous containers
# JUDGE_INTERACTIVE_WALL_S=60    # whole-run budget for Run/Submit
# JUDGE_VERIFY_WALL_S=300        # whole-run budget for pipeline verification, where nobody waits
# JUDGE_PER_TEST_LIMIT_S=2
# JUDGE_ORACLE_LIMIT_S=10
# JUDGE_MEMORY=256m
# JUDGE_CPUS=1
# JUDGE_PIDS_LIMIT=64
